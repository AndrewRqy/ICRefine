\@writefile{toc}{\contentsline {paragraph}{Principle 1: Task failure structure, not model identity, governs transferability.}{13}{section*.32}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Observation 2: On the two tasks with non-trivial Phase~2 effects, oracle context helps where failure modes are principled and hurts where they are idiosyncratic.}{13}{section*.33}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Principle 3: A strong single-pass generator may extract holistic heuristics that iterative patching cannot recover.}{13}{section*.34}\protected@file@percent }
