\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}Mechanism 2: oracle contamination}{8}{subsection.2.4}\protected@file@percent }
\newlabel{sec:oracle}{{2.4}{8}{Mechanism 2: oracle contamination}{subsection.2.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Oracle-free Phase~2 generates more transferable case studies.}{8}{section*.20}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces E3 oracle ablation on causal\_judgement (RF, 5 models). E3: both Phase~1 and Phase~2 oracle disabled (\texttt  {--no-oracle}); Phase~2 generates case studies without gold chain-of-thought. v3 full: standard oracle-enabled pipeline. $\Delta $\,=\,E3 full\,$-$\,v3 full. \textbf  {Both columns are 3-seed means} (E3 and v3 each averaged over 3 independent pipeline runs); improvements range from $+1.9$ to $+3.8$\,pp. The train model (mini*, $+1.9$\,pp) and Gemini ($+1.9$\,pp) improvements approach the 2--4\,pp noise floor; non-train improvements for GPT-4.1 ($+3.1$\,pp), Claude ($+3.5$\,pp), and Llama ($+3.8$\,pp) are more robustly above it. * denotes the training model.}}{9}{table.caption.21}\protected@file@percent }
\newlabel{tab:e3_oracle}{{4}{9}{E3 oracle ablation on causal\_judgement (RF, 5 models). E3: both Phase~1 and Phase~2 oracle disabled (\texttt {--no-oracle}); Phase~2 generates case studies without gold chain-of-thought. v3 full: standard oracle-enabled pipeline. $\Delta $\,=\,E3 full\,$-$\,v3 full. \textbf {Both columns are 3-seed means} (E3 and v3 each averaged over 3 independent pipeline runs); improvements range from $+1.9$ to $+3.8$\,pp. The train model (mini*, $+1.9$\,pp) and Gemini ($+1.9$\,pp) improvements approach the 2--4\,pp noise floor; non-train improvements for GPT-4.1 ($+3.1$\,pp), Claude ($+3.5$\,pp), and Llama ($+3.8$\,pp) are more robustly above it. * denotes the training model}{table.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Oracle contamination gradient on causal\_judgement (left, full CS accuracy) and geometric\_shapes (right, full CS accuracy) across three oracle conditions: E3 no-oracle, v3 standard (Phase~2 oracle only), and v5 full-oracle (both Phase~1 and Phase~2 oracle enabled). All values are 3-seed means. On CJ, removing oracle access consistently improves transfer: E3 $>$ v3 for 4 of 5 models; full oracle (v5) degrades accuracy further for GPT-4.1, Gemini, and Llama. On GS, oracle effects are less consistent, reflecting that GS case study harm is structural (SVG parsing) rather than oracle-contamination driven.}}{9}{figure.caption.22}\protected@file@percent }
\newlabel{fig:oracle_gradient}{{4}{9}{Oracle contamination gradient on causal\_judgement (left, full CS accuracy) and geometric\_shapes (right, full CS accuracy) across three oracle conditions: E3 no-oracle, v3 standard (Phase~2 oracle only), and v5 full-oracle (both Phase~1 and Phase~2 oracle enabled). All values are 3-seed means. On CJ, removing oracle access consistently improves transfer: E3 $>$ v3 for 4 of 5 models; full oracle (v5) degrades accuracy further for GPT-4.1, Gemini, and Llama. On GS, oracle effects are less consistent, reflecting that GS case study harm is structural (SVG parsing) rather than oracle-contamination driven}{figure.caption.22}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}Mechanism 3: bootstrap convergence and sequential patching limits}{9}{subsection.2.5}\protected@file@percent }
\newlabel{sec:phases}{{2.5}{9}{Mechanism 3: bootstrap convergence and sequential patching limits}{subsection.2.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Per-seed (dots) and 3-seed mean (bars) full CS accuracy on geometric\_shapes under E3 (no oracle), v3 (Phase~2 oracle), and v5 (both oracles). Unlike causal\_judgement---where E3 $>$ v3 holds for all seeds and all models---GS shows no consistent oracle ordering. Within-condition $\sigma $ values (bottom labels) are 3--10\,pp, comparable to the cross-condition differences, confirming that oracle injection provides no reliable signal on this task. GS case study harm is structural (SVG path parsing difficulty) rather than oracle-contamination driven.}}{10}{figure.caption.23}\protected@file@percent }
\newlabel{fig:gs_oracle_variance}{{5}{10}{Per-seed (dots) and 3-seed mean (bars) full CS accuracy on geometric\_shapes under E3 (no oracle), v3 (Phase~2 oracle), and v5 (both oracles). Unlike causal\_judgement---where E3 $>$ v3 holds for all seeds and all models---GS shows no consistent oracle ordering. Within-condition $\sigma $ values (bottom labels) are 3--10\,pp, comparable to the cross-condition differences, confirming that oracle injection provides no reliable signal on this task. GS case study harm is structural (SVG path parsing difficulty) rather than oracle-contamination driven}{figure.caption.23}{}}
